# Kopiere diese Datei zu .env und trage deine echten Werte ein.

# LLM (lokal via Ollama, ein Modell für alles)
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m
AGENT_MODEL_FAST=qwen3.5:9b
AGENT_MODEL_STRONG=qwen3.5:9b

# Claude Haiku – Echtzeit-Chat (API-Key erforderlich, sonst Fallback auf Ollama)
ANTHROPIC_API_KEY=
CLAUDE_CHAT_MODEL=claude-haiku-4-5-20251001

# MLX (großes lokales Modell für Background-Tasks, direkt via mlx_lm — kein Ollama)
# Leer lassen → Background-LLM bleibt Ollama
MLX_BG_MODEL=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: weitere autorisierte Telegram-IDs (kommagetrennt).
# TELEGRAM_CHAT_ID ist immer erlaubt; nur gelistete IDs dürfen mit Mantis reden.
TELEGRAM_ALLOWED_IDS=

# Besitzer (persönliche Daten – bleiben lokal)
OWNER_NAME=DeinName
OWNER_EMAIL=
OWNER_TIMEZONE=Europe/Berlin

# Datenquellen (direkt von der Quelle)
HEALTH_JSON_PATH=~/Library/Mobile Documents/iCloud~is~workflow~my~workflows/Documents/Health.json
CALENDAR_ICS_URLS=          # kommagetrennte ICS-Abo-URLs (Google/iCloud Kalender)

# COROS-MCP (optional, siehe docs/coros-setup.md). EU-Route als Default;
# mcpus/mcpcn falls der Account dort liegt.
# COROS_MCP_URL=https://mcpeu.coros.com/mcp

# Datenbank (PostgreSQL + pgvector)
DATABASE_URL=postgresql://localhost:5432/mantis

# Thermal
THERMAL_TARGET_CELSIUS=70.0
THERMAL_MAX_CELSIUS=85.0

# Web-Suche (optional)
BRAVE_API_KEY=

# Spotify-Suche für „spiel [X]" (developer.spotify.com, kostenlos; optional)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Accountability & Momentum (v0: Daily Anchor + Der Block)
ACCOUNTABILITY_ENABLED=true
ACCOUNTABILITY_ANCHOR_TIME=08:00      # Morgen-Anker: "Was ist das EINE Ding heute?"
ACCOUNTABILITY_BLOCK_START=10:00      # Deep-Work-Block Start ("Handy weg.")
ACCOUNTABILITY_BLOCK_MINUTES=90       # Blockdauer; Ende = Start + Dauer
