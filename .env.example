# Dashboard: mandatory random token (e.g. python3 -c 'import secrets; print(secrets.token_urlsafe(32))').
# Blank token disables protected routes. Set an explicit Tailscale IP for remote access.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=7779
DASHBOARD_TOKEN=
DASHBOARD_ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# Kopiere diese Datei zu .env und trage deine echten Werte ein.

# LLM (Generierung über vorhandene Cloud-Backends)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
CHAT_ANTHROPIC_MODEL=claude-haiku-5-5
CHAT_CLOUD_MODEL=openai/gpt-6-luna
CHAT_CLOUD_FALLBACK_MODEL=
CHAT_CLOUD_REASONING_EFFORT=low
CHAT_CLOUD_TIMEOUT_S=30
CHAT_CHATGPT_PLAN_ENABLED=true
CHAT_CHATGPT_PLAN_MODEL=gpt-6-luna
CHATGPT_AUTH_FILE=~/.config/mantis/chatgpt_auth.json
# Ollama wird ausschließlich für lokale Embeddings genutzt.
OLLAMA_BASE_URL=http://localhost:11434
LZG_EMBED_MODEL=qwen3-embedding:0.6b
LLM_LOCAL_ONLY=false

# Jev (TypeSafe) über OpenRouter für Ja/Nein-/Kategorie-Entscheidungen. Opt-in.
JEV_ENABLED=false
# JSONL-Log aller Jev-Antworten (leer = aus), z.B. data/jev_decisions.jsonl
JEV_LOG_PATH=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: weitere autorisierte Telegram-IDs (kommagetrennt).
# TELEGRAM_CHAT_ID ist immer erlaubt; nur gelistete IDs dürfen mit Mantis reden.
TELEGRAM_ALLOWED_IDS=

# Discord-DM (optional). Agent Remote bleibt standardmäßig deaktiviert.
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=
DISCORD_CHANNEL_ID=
AGENT_REMOTE_ENABLED=false
# Vertrauenswürdige Repo-Allowlist; Chat-Pfade werden ignoriert.
AGENT_REMOTE_REPOS={"mantis":"~/Mantis"}
CODEX_TASK_MODEL=gpt-6-luna
CODEX_TASK_EFFORT=max

# Besitzerprofil (persönliche Angaben können in Cloud-LLM-Kontexten verwendet werden).
OWNER_NAME=DeinName
OWNER_EMAIL=
OWNER_TIMEZONE=Europe/Berlin

# Datenquellen (direkt von der Quelle)
HEALTH_JSON_PATH=~/Library/Mobile Documents/iCloud~is~workflow~my~workflows/Documents/Health.json
CALENDAR_ICS_URLS=          # kommagetrennte ICS-Abo-URLs (Google/iCloud Kalender)

# COROS-MCP (optional, siehe docs/coros-setup.md). EU-Route als Default;
# mcpus/mcpcn falls der Account dort liegt.
# COROS_MCP_URL=https://mcpeu.coros.com/mcp

# Datenbank (PostgreSQL + pgvector)
DATABASE_URL=postgresql://localhost:5432/mantis

# Thermal
THERMAL_TARGET_CELSIUS=70.0
THERMAL_MAX_CELSIUS=85.0

# Web-Suche (optional)
BRAVE_API_KEY=

# Spotify Web-API (Developer-App; einmalig: python3 scripts/spotify_auth.py)
# Redirect URI: http://127.0.0.1:8084/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional: exakter Spotify-Connect-Gerätename, z.B. "MacBook Air von Timo"
SPOTIFY_DEVICE_NAME=

# Accountability & Momentum (v0: Daily Anchor + Der Block)
ACCOUNTABILITY_ENABLED=true
ACCOUNTABILITY_ANCHOR_TIME=08:00      # Morgen-Anker: "Was ist das EINE Ding heute?"
ACCOUNTABILITY_BLOCK_START=10:00      # Deep-Work-Block Start ("Handy weg.")
ACCOUNTABILITY_BLOCK_MINUTES=90       # Blockdauer; Ende = Start + Dauer
